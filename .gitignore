# Downloaded/extracted toolchains (recreate with scripts/setup-tools.py)
/tools/
# Build outputs
/build/
*.obj
*.err
*.map
*.exe
*.com
*.img
# The user's own (commercial) disk images, used by the image build
/external/
__pycache__/
# Local bridge provider config (see bridge/providers.example.toml)
/bridge/providers.toml
# Local secrets (ANTHROPIC_API_KEY etc.; read by bridge/dosbridge.py)
/.env
# Bridge debug logs (dosbridge.log, replay.log, saved sessions)
/bridge/*.log*
# Conversation logs (JSONL, bridge/convlog.py)
/bridge/logs/
# Python virtualenv for the bridge (pip install -r bridge/requirements.txt)
/.venv/
