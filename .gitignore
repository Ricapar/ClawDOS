# Downloaded/extracted toolchains (recreate with scripts/setup-tools.py)
/tools/
# Build outputs
/build/
*.obj
*.err
*.map
*.exe
*.com
*.img
# The user's own (commercial) disk images, used by the image build
/external/
__pycache__/
# Local secrets (ANTHROPIC_API_KEY, baked into the image's CLAWDOS.CFG by build.py)
/.env
# Tunnel and mock logs
/tunnel/*.log*
# Leftovers from the bridge days: its virtualenv and its local conversation logs
/.venv/
/bridge/
