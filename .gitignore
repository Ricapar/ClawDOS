# Downloaded/extracted toolchains (recreate with scripts/setup-tools.ps1)
/tools/
# Build outputs
/build/
*.obj
*.err
*.map
*.exe
*.com
*.img
__pycache__/
# Local bridge provider config (see bridge/providers.example.toml)
/bridge/providers.toml
# Local secrets (ANTHROPIC_API_KEY etc.; read by bridge/xtbridge.py)
/.env
# Bridge debug logs (xtbridge.log, replay.log, saved sessions)
/bridge/*.log*
# Conversation logs (JSONL, bridge/convlog.py)
/bridge/logs/
