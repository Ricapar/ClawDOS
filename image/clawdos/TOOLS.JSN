[
 {
  "name": "sysinfo",
  "description": "Describe the DOS PC: DOS version, total and free memory, EMS, drives with free space, BIOS date, video adapter, date and time, IP address.",
  "input_schema": {
   "type": "object",
   "properties": {},
   "required": []
  }
 },
 {
  "name": "dir",
  "description": "List a directory: names, sizes, dates, attributes. DOS 8.3 names.",
  "input_schema": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "description": "Directory or wildcard pattern, e.g. C:\\ or C:\\DOS\\*.EXE"
    }
   },
   "required": [
    "path"
   ]
  }
 },
 {
  "name": "read",
  "description": "Read a file. Text files come back as numbered lines; binary files as a hex dump. Keep reads targeted: the link is slow.",
  "input_schema": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "description": "File to read, e.g. C:\\AUTOEXEC.BAT"
    },
    "start": {
     "type": "string",
     "description": "Text: first line number (default 1)"
    },
    "lines": {
     "type": "string",
     "description": "Text: how many lines (default 100)"
    },
    "offset": {
     "type": "string",
     "description": "Binary: first byte offset (default 0)"
    },
    "bytes": {
     "type": "string",
     "description": "Binary: how many bytes, up to 256 (default 256)"
    }
   },
   "required": [
    "path"
   ]
  }
 },
 {
  "name": "search",
  "description": "Find the lines that contain a piece of text in files, with line numbers: much faster than running FIND. Plain text, not a pattern; case is ignored unless case=1. Binary files are skipped.",
  "input_schema": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string",
     "description": "The text to look for, on one line"
    },
    "path": {
     "type": "string",
     "description": "Files to search: a file, a directory or a wildcard; several separated by spaces, e.g. C:\\WG\\*.C C:\\WG\\*.H"
    },
    "case": {
     "type": "string",
     "description": "1 to match case exactly"
    }
   },
   "required": [
    "text",
    "path"
   ]
  }
 },
 {
  "name": "peek",
  "description": "Hex and ASCII dump of memory, e.g. 0040:0000 is the BIOS data area, F000:FFF5 the BIOS date, B800:0000 the screen.",
  "input_schema": {
   "type": "object",
   "properties": {
    "addr": {
     "type": "string",
     "description": "Address as hex seg:off, e.g. 0040:0000"
    },
    "len": {
     "type": "string",
     "description": "Bytes to dump, up to 256 (decimal or 0x hex; default 64)"
    }
   },
   "required": [
    "addr"
   ]
  }
 },
 {
  "name": "write",
  "description": "Create or overwrite a text file (newlines are written as CRLF), or append to one. The user may be asked to approve.",
  "input_schema": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "description": "File to write; at most 64 characters, 8.3 names"
    },
    "text": {
     "type": "string",
     "description": "The file's contents"
    },
    "append": {
     "type": "string",
     "description": "1 to append instead of overwriting"
    }
   },
   "required": [
    "path",
    "text"
   ]
  }
 },
 {
  "name": "edit",
  "description": "Change part of a text file: replace an exact piece of its text with new text, instead of rewriting the whole file with write. old must match the file exactly, spaces, tabs and line breaks included (copy it from a read, without the line numbers), and occur once unless all=1. You get the changed lines back, numbered. The file keeps its line ends. Files up to 60000 bytes. The user may be asked to approve.",
  "input_schema": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "description": "The file to change"
    },
    "old": {
     "type": "string",
     "description": "The exact text to replace, with enough lines to be unique"
    },
    "new": {
     "type": "string",
     "description": "The text to put in its place (empty to delete it)"
    },
    "all": {
     "type": "string",
     "description": "1 to replace every occurrence"
    }
   },
   "required": [
    "path",
    "old",
    "new"
   ]
  }
 },
 {
  "name": "delete",
  "description": "Delete one file (no wildcards; use run with DEL for those).",
  "input_schema": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "description": "File to delete"
    }
   },
   "required": [
    "path"
   ]
  }
 },
 {
  "name": "mkdir",
  "description": "Create a directory.",
  "input_schema": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "description": "Directory to create"
    }
   },
   "required": [
    "path"
   ]
  }
 },
 {
  "name": "rename",
  "description": "Rename or move a file within a drive.",
  "input_schema": {
   "type": "object",
   "properties": {
    "from": {
     "type": "string",
     "description": "Existing file"
    },
    "to": {
     "type": "string",
     "description": "New name"
    }
   },
   "required": [
    "from",
    "to"
   ]
  }
 },
 {
  "name": "run",
  "description": "Run DOS command lines (programs, .BAT files, internal commands like DIR, TYPE, DEL). The screen switches to DOS while they run; you get the output each printed (or the final screen text) and its exit code, which FreeCOM passes through from the program (e.g. 2 for DIR of a missing file). Put several commands on separate lines (up to 12) to run them in order: they stop at the first whose exit code isn't 0, e.g. compile two files and link in one call. There is no & or && chaining. Programs cannot use the network, there is no way to type into them, and Ctrl-C can't stop them, so avoid interactive or endless programs.",
  "input_schema": {
   "type": "object",
   "properties": {
    "command": {
     "type": "string",
     "description": "The command line, at most 120 characters; or several, one per line"
    }
   },
   "required": [
    "command"
   ]
  }
 },
 {
  "name": "poke",
  "description": "Write bytes to memory. Careful: wrong addresses can crash the DOS PC.",
  "input_schema": {
   "type": "object",
   "properties": {
    "addr": {
     "type": "string",
     "description": "Address as hex seg:off, e.g. B800:0000"
    },
    "bytes": {
     "type": "string",
     "description": "Hex byte values separated by spaces, e.g. \"41 1E 42 1E\""
    }
   },
   "required": [
    "addr",
    "bytes"
   ]
  }
 },
 {
  "name": "port",
  "description": "Read or write one I/O port byte, e.g. 61 (speaker/keyboard control), 3D9 (CGA colour select), 3DA (CGA status).",
  "input_schema": {
   "type": "object",
   "properties": {
    "port": {
     "type": "string",
     "description": "Port number in hex, e.g. 3D9"
    },
    "value": {
     "type": "string",
     "description": "Byte to write (decimal or 0x hex); omit to read"
    }
   },
   "required": [
    "port"
   ]
  }
 },
 {
  "name": "play",
  "description": "Play music on the PC speaker using a GW-BASIC PLAY string, e.g. \"T120 O3 L8 CDEFG4\". Notes A-G with # or + (sharp) and - (flat), optionally followed by a length; On octave 0-6 (O3 starts at middle C, default O4); < and > change octave; Nn plays note number 0-84 (0 = rest); Ln default length 1-64 (4 = quarter note); Pn or Rn rest; Tn tempo 32-255 quarter notes per minute (default 120); a dot after a note makes it 1.5 times as long; MN normal, ML legato, MS staccato. Esc stops playback.",
  "input_schema": {
   "type": "object",
   "properties": {
    "music": {
     "type": "string",
     "description": "The PLAY string"
    }
   },
   "required": [
    "music"
   ]
  }
 },
 {
  "name": "textart",
  "description": "Print coloured text art into the chat transcript (80x25 text mode, code page 437 characters such as box drawing and blocks). ~X, with X a hex digit, sets the colour (0 black, 1 blue, 2 green, 3 cyan, 4 red, 5 magenta, 6 brown, 7 grey, 8 dark grey, 9-F bright versions; E yellow, F white); ~~ is a literal ~. Lines over 78 columns are cut, at most 40 lines.",
  "input_schema": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string",
     "description": "The text, with newlines between lines"
    }
   },
   "required": [
    "text"
   ]
  }
 },
 {
  "name": "memory_list",
  "description": "List your memories on this machine (C:\\MEMORY): name, size and first line of each. The list as of the start of the conversation is already in your instructions.",
  "input_schema": {
   "type": "object",
   "properties": {},
   "required": []
  }
 },
 {
  "name": "memory_read",
  "description": "Read one of your memories in full.",
  "input_schema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "description": "The memory's name, e.g. TRAINS"
    }
   },
   "required": [
    "name"
   ]
  }
 },
 {
  "name": "memory_write",
  "description": "Save a memory for future conversations, replacing any with the same name. Never needs the user's approval. Make the first line a one-line summary; at most 4000 bytes.",
  "input_schema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "description": "1-8 letters, digits, _ or -, e.g. TRAINS"
    },
    "text": {
     "type": "string",
     "description": "The memory's text"
    }
   },
   "required": [
    "name",
    "text"
   ]
  }
 }
]
